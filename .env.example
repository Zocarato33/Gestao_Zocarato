# Porta HTTP do servidor
PORT=3000

# Conexão com o PostgreSQL. No Neon, copie a "connection string" do painel do projeto.
# Para o banco local do docker compose: postgres://postgres:postgres@localhost:5432/gestao
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gestao

# Fuso horário usado para calcular prazos vencidos
APP_TZ=America/Sao_Paulo

# Duração da sessão em horas
SESSAO_HORAS=12

# Defina como true quando o sistema estiver atrás de HTTPS (produção)
COOKIE_SECURE=false

# Defina como true se houver proxy reverso (Vercel, Render, Nginx, Caddy etc.) na frente do sistema
TRUST_PROXY=false
