# Porta HTTP do servidor
PORT=3000

# Caminho do arquivo do banco de dados SQLite (criado automaticamente)
DB_PATH=./data/gestao.db

# Fuso horário usado para calcular prazos vencidos
APP_TZ=America/Sao_Paulo

# Duração da sessão em horas
SESSAO_HORAS=12

# Defina como true quando o sistema estiver atrás de HTTPS (produção)
COOKIE_SECURE=false

# Defina como true se houver proxy reverso (Nginx, Caddy, etc.) na frente do sistema
TRUST_PROXY=false
